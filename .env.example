# Copy to .env. Everything works with no values set.

# Where PGlite (embedded Postgres) stores data. Delete the folder to reset.
DATABASE_DIR=.data/pglite

# Optional. When unset, the AI helper in src/server/lib/ai.ts uses a fake
# provider that returns canned text, so nothing here needs a key to run.
ANTHROPIC_API_KEY=

# External services (EHR and email), described in docs/integrations/.
# Ask Jack for a key. Set INTEGRATIONS=local to use in-process stand-ins
# instead (tests do this; nothing leaves your machine, nothing is real).
INTEGRATIONS_BASE_URL=https://huxley-lite-services.outro.workers.dev
INTEGRATIONS_API_KEY=
